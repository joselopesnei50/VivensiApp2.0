# Valores OBRIGATÓRIOS para produção
# Copie as linhas relevantes para o .env real no VPS e ajuste os valores.
# NUNCA commite o .env real no repositório.

APP_NAME="Vivensi"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seudominio.com.br

# Banco de dados
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vivensi
DB_USERNAME=vivensi_app   # usuário com privilégios mínimos (sem DROP/CREATE)
DB_PASSWORD=TROCAR

# Redis (obrigatório para cache, filas e sessão)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Sessão segura (OBRIGATÓRIO em HTTPS)
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# Broadcasting (Pusher ou Soketi)
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=TROCAR
PUSHER_APP_KEY=TROCAR
PUSHER_APP_SECRET=TROCAR
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Storage
FILESYSTEM_DISK=local
# Para S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=TROCAR
# AWS_SECRET_ACCESS_KEY=TROCAR
# AWS_DEFAULT_REGION=sa-east-1
# AWS_BUCKET=TROCAR

# Email
MAIL_MAILER=smtp
MAIL_HOST=TROCAR
MAIL_PORT=587
MAIL_USERNAME=TROCAR
MAIL_PASSWORD=TROCAR
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@seudominio.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Observabilidade
SENTRY_LARAVEL_DSN=TROCAR
LOG_CHANNEL=daily
LOG_LEVEL=error

# Pagamentos
ABACATEPAY_API_KEY=TROCAR
ABACATEPAY_HMAC_KEY=TROCAR
PAGSEGURO_TOKEN=TROCAR
ASAAS_API_KEY=TROCAR
OPENPIX_APP_ID=TROCAR

# WhatsApp
META_WHATSAPP_TOKEN=TROCAR
META_PHONE_NUMBER_ID=TROCAR
META_WEBHOOK_VERIFY_TOKEN=TROCAR
EVOLUTION_API_URL=TROCAR
EVOLUTION_GLOBAL_KEY=TROCAR

# IA
GEMINI_API_KEY=TROCAR
DEEPSEEK_API_KEY=TROCAR
