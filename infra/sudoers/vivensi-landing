# Sudoers pra custom domain de landing pages (Fase 2 do add-on).
# Deploy: sudo wget -O /etc/sudoers.d/vivensi-landing <URL_RAW>
# Valida: sudo visudo -c
#
# Whitelist minima: certbot + nginx test + reload. Os arquivos de config
# nginx sao escritos direto pelo PHP em /etc/nginx/sites-available/
# vivensi-landings/ (dir owned by www-data), sem sudo. Include desse
# dir no nginx.conf principal e feito uma vez no setup do VPS.

www-data ALL=(root) NOPASSWD: /usr/bin/certbot
www-data ALL=(root) NOPASSWD: /usr/sbin/nginx -t
www-data ALL=(root) NOPASSWD: /bin/systemctl reload nginx
