APP_NAME=Vivensi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seudominio.com.br

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vivensi
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# CACHE_DRIVER: use "file" no deploy inicial; troque para "redis" após confirmar Redis rodando
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# QUEUE_CONNECTION: "database" requer tabela jobs (já migrada). Use "redis" com Horizon após deploy OK.
QUEUE_CONNECTION=database
# SESSION_DRIVER: use "file" no deploy inicial; troque para "redis" após confirmar Redis rodando
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS — separar múltiplos domínios por vírgula
CORS_ALLOWED_ORIGINS=https://seudominio.com.br

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=sandbox

# PagSeguro
PAGSEGURO_TOKEN=
PAGSEGURO_WEBHOOK_TOKEN=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evo.seudominio.com.br
EVOLUTION_GLOBAL_KEY=

# Meta / Facebook
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=

# IA
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Marketing / Email
BREVO_API_KEY=
SERPER_API_KEY=
GOOGLE_MAPS_API_KEY=
