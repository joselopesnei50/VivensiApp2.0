APP_NAME=Vivensi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seudominio.com.br

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vivensi
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher

# ── Performance / Redis ───────────────────────────────────────────────────────
# Após confirmar Redis rodando no VPS, troque file/database → redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
FILESYSTEM_DISK=local

# CORS — separar múltiplos domínios por vírgula
CORS_ALLOWED_ORIGINS=https://seudominio.com.br

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

# ── Horizon ───────────────────────────────────────────────────────────────────
HORIZON_NAME=Vivensi
HORIZON_PREFIX=vivensi_horizon:

# ── Observabilidade (Sentry) ──────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=sa1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=sandbox

# AbacatePay
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_HMAC_KEY=gere_uma_chave_segura_aqui
ABACATEPAY_ENV=sandbox

# PagSeguro
PAGSEGURO_TOKEN=
PAGSEGURO_WEBHOOK_TOKEN=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evo.seudominio.com.br
EVOLUTION_GLOBAL_KEY=

# Chave dedicada para blind index dos tokens de instância WhatsApp.
# Se vazia, fallback para APP_KEY (mantém compatibilidade). Para ativar
# a separação (recomendado em prod), gere com:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
# e rode em seguida: php artisan whatsapp:rebuild-bidx --apply
WHATSAPP_BIDX_KEY=

# Tunings do AntiBanManager (Tarefa 3.2). Valores deixados em branco usam
# os defaults da casa (55 mensagens/hora, 24h de restrição ao detectar
# sinal de ban). Override por instância em settings.max_per_hour.
# Ver docs/WHATSAPP_TUNING.md para perfil 'conservative' e ativação.
WHATSAPP_MAX_PER_HOUR=
WHATSAPP_BAN_RESTRICTION_HOURS=

# Meta / Facebook
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=

# IA
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Marketing / Email
BREVO_API_KEY=
SERPER_API_KEY=
GOOGLE_MAPS_API_KEY=

# GitHub Auto-Deploy Webhook
DEPLOY_WEBHOOK_SECRET=seu_token_secreto_aqui
