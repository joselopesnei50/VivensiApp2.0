{
  "meta": {
    "project": "Vivensi - Security Hardening and Production Readiness",
    "date": "2026-04-23",
    "prepared_by": "Generated by TestSprite"
  },
  "product_overview": "A Laravel-based multi-tenant SaaS (Vivensi) being prepared for production by implementing webhook signature verification, input sanitization, tenant isolation hardening, anti-abuse/rate controls for WhatsApp/Evolution integrations, and improved monitoring/alerts.",
  "core_goals": [
    "Protect all inbound webhooks (Evolution, WhatsApp, payment providers) with verifiable signatures or HMAC to prevent spoofing and replay.",
    "Sanitize and validate external text payloads (WhatsApp bot inputs) before persisting to prevent stored XSS and injection.",
    "Enforce strict multi-tenant isolation for data and real-time channels (Laravel Echo/broadcasting) to prevent cross-tenant leaks.",
    "Introduce AntiBan and rate-control mechanisms for Evolution/WhatsApp integrations to avoid provider bans and service overload.",
    "Apply per-route rate limiting and monitoring/alerting for critical webhook routes and queue job failures."
  ],
  "features": [
    {
      "name": "Webhook Signature Verification",
      "description": "Add middleware and verification for inbound webhooks (Evolution, WhatsApp bot, payments) to authenticate requests using a token + signature header (HMAC) and reject invalid requests.",
      "user_flows": [
        "POST /api/evo/webhook/{token} with valid Webhook-Signature header -> Receive 200 OK",
        "POST /api/evo/webhook/{token} with missing or invalid Webhook-Signature header -> Receive 401 Unauthorized",
        "GET /api/whatsapp/webhook with valid hub.verify_token and hub.challenge -> Receive 200 with hub.challenge value",
        "GET /api/whatsapp/webhook with invalid/missing hub.verify_token -> Receive 403 Forbidden",
        "POST /api/webhooks/pagseguro with valid HMAC header -> Receive 200 OK",
        "POST /api/webhooks/pagseguro with missing/invalid HMAC header -> Receive 401 Unauthorized"
      ]
    },
    {
      "name": "WhatsApp Payload Sanitization (WhatsAppBotController)",
      "description": "Sanitize and validate incoming WhatsApp message text and attachments before any DB writes (strip tags/HTMLPurifier, validate numeric fields, validate Base64/mimetypes for media).",
      "user_flows": [
        "POST /api/whatsapp/webhook with message payload 'DESP: 100 | Grocery' and valid signature -> Receive 200 OK -> Internal POST /transactions with sanitized description 'Grocery' -> Receive 201 Created",
        "POST /api/whatsapp/webhook with message payload containing '<script>alert(1)</script>' and valid signature -> Receive 200 OK -> Internal POST /transactions with description sanitized to remove tags -> Receive 201 Created",
        "POST /api/whatsapp/webhook with message payload containing '<script>alert(1)</script>' and no sanitization present -> Receive 200 OK -> GET /transactions/{id} as admin -> Receive 200 HTML view containing unsanitized description (stored XSS risk)"
      ]
    },
    {
      "name": "Multi-tenant Channel Authorization (Broadcasting Auth)",
      "description": "Enforce tenant-scoped authorization for broadcasting channels (e.g., tenant.{tenantId}.whatsapp) and ensure channels are declared/authorized in routes/channels.php so subscriptions cannot leak cross-tenant events.",
      "user_flows": [
        "POST /broadcasting/auth with auth token and channel 'private-tenant.{tenantId}.whatsapp' where token belongs to same tenant -> Receive 200 Authorized",
        "POST /broadcasting/auth with auth token and channel 'private-tenant.{otherTenantId}.whatsapp' where token belongs to different tenant -> Receive 403 Forbidden",
        "GET /notifications with valid user session -> Receive 200 Notification[] (notifications scoped to user's tenant)",
        "GET /dashboard with valid user session for tenant A -> Receive 200 HTML view with KPIs scoped to tenant A (no tenant B data present)"
      ]
    },
    {
      "name": "AntiBanManager & Evolution API Rate Control",
      "description": "Introduce AntiBanManager (client-side delays and dynamic throttling) inside the EvolutionApiService to randomize/schedule outbound messages, backoff on errors, and integrate quotas to avoid Meta/Evolution account bans.",
      "user_flows": [
        "POST /api/whatsapp/instances/{id}/connect with valid auth -> Receive 200 with connection status (QR or connected) -> Subsequent internal sendMessage calls use AntiBanManager to schedule messages with randomized delays",
        "POST /api/whatsapp/instances/{id}/connect called repeatedly beyond configured rate -> Receive 429 Too Many Requests",
        "POST /api/whatsapp/instances/{id}/connect with malformed media (invalid Base64) -> Receive 422 Validation error (media failed integrity checks)"
      ]
    },
    {
      "name": "Webhook Throttling, Queue Failure Alerts & Monitoring",
      "description": "Apply conservative per-route rate limits to webhook endpoints, add failed() handlers for critical jobs to push alerts, and expose admin views for webhook metrics and queue/job failures (Horizon gated to super-admins).",
      "user_flows": [
        "POST /api/whatsapp/webhook with valid payload within rate limits -> Receive 200 OK -> Job queued for processing (worker handles job normally)",
        "POST /api/whatsapp/webhook in a flood pattern exceeding throttle limits -> Receive 429 Too Many Requests",
        "POST /api/webhooks/asaas with valid payload -> Receive 200 OK -> Worker processes payment webhook -> If job fails more than threshold, failed job triggers alert -> GET /admin as super_admin -> Receive 200 Admin dashboard showing webhook failure alert/metric"
      ]
    }
  ],
