#!/usr/bin/env bash
# Vivensi pre-commit hook: escaneia arquivos staged com gitleaks.
#
# Ativar (uma vez por clone):
#   git config core.hooksPath .githooks
#
# Instalar gitleaks:
#   macOS:   brew install gitleaks
#   Windows: winget install gitleaks.gitleaks   (ou scoop install gitleaks)
#   Linux:   https://github.com/gitleaks/gitleaks#installing

set -e

# Localiza o binário do gitleaks. Prioriza PATH, cai para paths conhecidos
# de instalação (útil no Windows quando o git-bash não pegou o PATH ainda).
find_gitleaks() {
    if command -v gitleaks >/dev/null 2>&1; then
        command -v gitleaks
        return 0
    fi
    local candidate
    for candidate in \
        "$HOME/AppData/Local/Microsoft/WinGet/Packages"/Gitleaks.Gitleaks_*/gitleaks.exe \
        "$HOME/scoop/apps/gitleaks/current/gitleaks.exe" \
        "/c/ProgramData/chocolatey/bin/gitleaks.exe" \
        "/usr/local/bin/gitleaks" \
        "/opt/homebrew/bin/gitleaks" \
        "/opt/gitleaks/gitleaks"
    do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

GITLEAKS_BIN="$(find_gitleaks 2>/dev/null || true)"

if [ -z "$GITLEAKS_BIN" ]; then
    echo "ℹ️  gitleaks não encontrado — scan de segredos pulado."
    echo "   Instale para ativar: https://github.com/gitleaks/gitleaks#installing"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$REPO_ROOT/.gitleaks.toml"

if [ ! -f "$CONFIG" ]; then
    echo "⚠️  .gitleaks.toml não encontrado — pulando scan"
    exit 0
fi

echo "🔍 gitleaks scan (staged files)..."
if ! "$GITLEAKS_BIN" protect --staged --config "$CONFIG" --redact --verbose; then
    echo ""
    echo "❌ gitleaks detectou possível segredo nos arquivos staged."
    echo "   Commit BLOQUEADO."
    echo ""
    echo "   → Se for credencial real: remova, rotacione, e não faça bypass."
    echo "   → Se for falso positivo: adicione o padrão ao [allowlist] em .gitleaks.toml"
    echo ""
    exit 1
fi

echo "✅ gitleaks OK"
exit 0
